    ) -> tuple[str, dict[str, Any]]:
        """
        Make the outtmpl and info_dict suitable for substitution: ydl.escape_outtmpl(outtmpl) % info_dict
        @param sanitize    Whether to sanitize the output as a filename
        """
        ...
