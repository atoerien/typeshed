    def record_download_archive(self, info_dict: _InfoDict) -> None: ...
    @staticmethod
    def format_resolution(format: Mapping[str, Any], default: str = "unknown") -> str: ...
    def render_formats_table(self, info_dict: _InfoDict) -> str | None: ...
