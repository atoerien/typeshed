    def list_subtitles(self, video_id: str, subtitles: Iterable[Mapping[str, Any]], name: str = "subtitles") -> None: ...
    def print_debug_header(self) -> None: ...
    @cached_property
    def proxies(self) -> dict[str, Any]:
